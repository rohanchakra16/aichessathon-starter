{
  "schema_version": 1,
  "github_repository": "rohanchakra16/aichessathon-starter",
  "candidate_timeout_seconds": 900,
  "ci_timeout_seconds": 1200,
  "release_timeout_seconds": 2400,
  "candidate_generators": {
    "primary": "claude-code",
    "secondary": "claude-code",
    "secondary_after_non_improvements": 3,
    "secondary_cadence": 3,
    "recent_experiment_limit": 12,
    "claude_model": "sonnet",
    "claude_effort": "high",
    "claude_max_budget_usd": 1.0
  },
  "candidate_allowed_paths": [
    "agent.py",
    "weights/"
  ],
  "protected_paths": [
    ".dockerignore",
    ".autoloop/protected/",
    ".github/workflows/",
    "AGENTS.md",
    "Makefile",
    "controller.py",
    "harness/",
    "tests/autoloop/"
  ],
  "submission": {
    "expanded_size_limit_bytes": 50000000,
    "required_root_files": ["agent.py"],
    "native_binary_suffixes": [
      ".a", ".bin", ".dll", ".dylib", ".exe", ".o", ".so", ".whl"
    ],
    "forbidden_shadow_names": [
      "chess.py", "json.py", "math.py", "os.py", "random.py", "sys.py", "types.py"
    ],
    "forbidden_source_terms": [
      "stockfish", "lc0", "leela chess zero", "maia", "subprocess", "socket", "urllib", "requests"
    ]
  },
  "reliability": {
    "max_init_seconds": 50.0,
    "max_single_move_seconds": 0.75,
    "max_single_move_seconds_by_clock": {
      "120000": 2.25
    },
    "stress_time_left_ms": [1, 25, 100, 1000, 120000],
    "required_failures": 0
  },
  "environment": {
    "cpu_quota_cores": 1.0,
    "memory_limit_bytes": 2147483648,
    "pids_limit": 128,
    "tmp_limit_bytes": 268435456,
    "require_network_disabled": true,
    "require_read_only_workspace": true
  },
  "model_ablation": {
    "model_path": "weights/model.json",
    "move_time_left_ms": 3000,
    "minimum_move_differences": 8,
    "strength_games": 16,
    "minimum_strength_score": 0.625,
    "base_ms": 3000,
    "increment_ms": 50,
    "ply_cap": 180
  },
  "arena": {
    "openings_file": ".autoloop/protected/openings.json",
    "games": 64,
    "minimum_games": 32,
    "batch_games": 16,
    "base_ms": 3000,
    "increment_ms": 50,
    "ply_cap": 180,
    "confidence_z": 1.6448536269514722,
    "null_score": 0.5
  },
  "confirmation_arena": {
    "openings_file": ".autoloop/protected/confirmation-openings.json",
    "games": 64,
    "minimum_games": 64,
    "batch_games": 64,
    "base_ms": 3000,
    "increment_ms": 50,
    "ply_cap": 180,
    "confidence_z": 1.6448536269514722,
    "null_score": 0.5
  },
  "real_clock_confirmation": {
    "openings_file": ".autoloop/protected/confirmation-openings.json",
    "maximum_openings": 4,
    "games": 8,
    "minimum_games": 8,
    "batch_games": 8,
    "base_ms": 120000,
    "increment_ms": 500,
    "ply_cap": 300,
    "confidence_z": 1.6448536269514722,
    "null_score": 0.5
  },
  "clock_sensitive_promotion": {
    "require_ci_passed": true,
    "allowed_fast_arena_decisions": ["accept", "inconclusive"],
    "real_clock_settings_key": "prospective_real_clock_arena",
    "required_real_clock_decision": "accept"
  },
  "prospective_real_clock_arena": {
    "openings_file": ".autoloop/protected/confirmation-openings.json",
    "opening_offset": 4,
    "maximum_openings": 8,
    "games": 16,
    "minimum_games": 16,
    "batch_games": 16,
    "base_ms": 120000,
    "increment_ms": 500,
    "ply_cap": 300,
    "confidence_z": 1.6448536269514722,
    "null_score": 0.5
  },
  "release": {
    "real_clock_games": 2,
    "base_ms": 120000,
    "increment_ms": 500,
    "ply_cap": 300
  },
  "competition_upload_enabled": false
}
